{
  "dashboard": {
    "id": null,
    "title": "Albo Pretorio Audit - System Metrics",
    "tags": ["regtech", "audit", "ocr", "pipeline"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 22,
    "version": 1,
    "links": [],
    "panels": [
      {
        "id": 1,
        "title": "Documents Processed Overview",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "increase(documents_processed_total[$__range])",
            "legendFormat": "{{document_type}} - {{processing_method}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "fieldOptions": {
            "defaults": {
              "mappings": [],
              "thresholds": {
                "steps": [
                  {"color": "green", "value": null},
                  {"color": "red", "value": 80}
                ]
              }
            },
            "overrides": []
          },
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,
        "title": "Processing Time Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(document_processing_seconds_bucket[$__rate_interval]))",
            "legendFormat": "{{document_type}} - {{processing_method}}",
            "refId": "A"
          }
        ],
        "options": {
          "tooltipOptions": {
            "mode": "single"
          }
        }
      },
      {
        "id": 3,
        "title": "Redis Queue Sizes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "redis_queue_size",
            "legendFormat": "{{queue_name}} - {{ente}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Worker Status",
        "type": "stat",
        "gridPos": {"h": 6, "w": 4, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "worker_status",
            "legendFormat": "{{worker_type}} - {{ente}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "fieldOptions": {
            "defaults": {
              "mappings": [
                {
                  "id": 0,
                  "op": "=",
                  "text": "Offline",
                  "type": 1,
                  "value": "0"
                },
                {
                  "id": 1,
                  "op": "=",
                  "text": "Online",
                  "type": 1,
                  "value": "1"
                }
              ],
              "thresholds": {
                "steps": [
                  {"color": "red", "value": null},
                  {"color": "green", "value": 1}
                ]
              }
            },
            "overrides": []
          },
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal"
        }
      },
      {
        "id": 5,
        "title": "Error Rates by Module",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 4, "y": 8},
        "targets": [
          {
            "expr": "rate(errors_total[$__rate_interval])",
            "legendFormat": "{{error_type}} - {{module}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Processing Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(documents_processed_total[$__rate_interval])) by (processing_method)",
            "legendFormat": "{{processing_method}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "OCR vs Standard Processing Ratio",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(increase(documents_processed_total[$__range])) by (processing_method)",
            "legendFormat": "{{processing_method}}",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        }
      },
      {
        "id": 8,
        "title": "Processing Time Heatmap",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "sum(increase(document_processing_seconds_bucket[$__interval])) by (le)",
            "refId": "A"
          }
        ],
        "options": {
          "yAxis": {
            "format": "short"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": [
        {
          "name": "ente",
          "type": "query",
          "query": "label_values(documents_processed_total, ente)",
          "refresh": 1,
          "options": [],
          "current": {
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "refresh": "5s",
    "schemaVersion": 22,
    "variables": {
      "list": []
    },
    "version": 1
  }
}